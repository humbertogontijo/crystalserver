diff --git a/data/scripts/eventcallbacks/monster/ondroploot_prey.lua b/data/scripts/eventcallbacks/monster/ondroploot_prey.lua
--- a/data/scripts/eventcallbacks/monster/ondroploot_prey.lua
+++ b/data/scripts/eventcallbacks/monster/ondroploot_prey.lua
@@ -24,7 +24,22 @@
 	local preyChance = 0
 	local preyActivators = {}
 	for _, participant in ipairs(participants) do
-		local participantChance = participant:getPreyLootPercentage(mType:raceId())
+		local raceId = mType:raceId()
+		local participantChance = 0
+		local teamPrey = TeamBonus and TeamBonus.effectivePrey and TeamBonus.effectivePrey(participant, raceId) or nil
+		if teamPrey then
+			-- Team prey on this race replaces personal loot prey.
+			if teamPrey.bonusType == 3 then -- Loot
+				participantChance = teamPrey.bonusPercent or 0
