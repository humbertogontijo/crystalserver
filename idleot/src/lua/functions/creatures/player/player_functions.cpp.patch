+int PlayerFunctions::luaPlayerSellAllShopItems(lua_State* L) {
+	// player:sellAllShopItems(ignoreEquipped, filterMode, itemIds)
+	// filterMode: 0 = skipped (sell all except list), 1 = accepted (sell only list)
+	const auto &player = Lua::getUserdataShared<Player>(L, 1);
+	if (!player) {
+		Lua::reportErrorFunc(Lua::getErrorDesc(LUA_ERROR_PLAYER_NOT_FOUND));
+		Lua::pushBoolean(L, false);
+		return 1;
+	}
+
+	const bool ignoreEquipped = Lua::getBoolean(L, 2, true);
+	const auto filterMode = Lua::getNumber<uint8_t>(L, 3, 0);
+
+	std::vector<uint16_t> itemIds;
+	if (lua_istable(L, 4) != 0) {
+		lua_pushnil(L);
+		while (lua_next(L, 4) != 0) {
+			if (itemIds.size() >= 512) {
+				lua_pop(L, 1);
+				break;
+			}
+			itemIds.push_back(Lua::getNumber<uint16_t>(L, -1));
+			lua_pop(L, 1);
+		}
+	}
+
+	g_game().playerSellAllItems(player->getID(), ignoreEquipped, filterMode, itemIds);
+	Lua::pushBoolean(L, true);
+	return 1;
+}
+
+int PlayerFunctions::luaPlayerAcceptsQuickLootItem(lua_State* L) {
+	// player:acceptsQuickLootItem(item) — mirrors Game::playerQuickLootCorpse list filter.
+	const auto &player = Lua::getUserdataShared<Player>(L, 1);
+	if (!player) {
+		Lua::reportErrorFunc(Lua::getErrorDesc(LUA_ERROR_PLAYER_NOT_FOUND));
+		Lua::pushBoolean(L, false);
+		return 1;
+	}
+	const auto &item = Lua::getUserdataShared<Item>(L, 2);
+	if (!item) {
+		Lua::reportErrorFunc(Lua::getErrorDesc(LUA_ERROR_ITEM_NOT_FOUND));
+		Lua::pushBoolean(L, false);
+		return 1;
+	}
+
+	// Headless companions may not have received the client filter push yet.
+	if (player->getProtocolVersion() == 0) {
+		g_game().inheritAccountQuickLootFilter(player);
+	}
+
+	const bool listed = player->isQuickLootListedItem(item);
+	const bool ignoreListItems = player->getQuickLootFilter() == QUICKLOOTFILTER_SKIPPEDLOOT;
+	const bool rejected = (listed && ignoreListItems) || (!listed && !ignoreListItems);
+	Lua::pushBoolean(L, !rejected);
+	return 1;
+}
+
+int PlayerFunctions::luaPlayerCollectQuickLootItem(lua_State* L) {
+	// player:collectQuickLootItem(item) — managed loot containers + capacity (one item).
+	const auto &player = Lua::getUserdataShared<Player>(L, 1);
+	if (!player) {
+		Lua::reportErrorFunc(Lua::getErrorDesc(LUA_ERROR_PLAYER_NOT_FOUND));
+		Lua::pushBoolean(L, false);
+		return 1;
+	}
+	const auto &item = Lua::getUserdataShared<Item>(L, 2);
+	if (!item) {
+		Lua::reportErrorFunc(Lua::getErrorDesc(LUA_ERROR_ITEM_NOT_FOUND));
+		Lua::pushBoolean(L, false);
+		return 1;
+	}
+
+	if (player->getProtocolVersion() == 0) {
+		g_game().inheritAccountQuickLootFilter(player);
+	}
+
+	const ObjectCategory_t category = g_game().getObjectCategory(item);
+	const ReturnValue ret = g_game().internalCollectManagedItems(player, item, category);
+	Lua::pushBoolean(L, ret == RETURNVALUE_NOERROR);
+	return 1;
+}
