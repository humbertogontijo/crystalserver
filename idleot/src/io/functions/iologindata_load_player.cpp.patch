From: IdleOT fork export <noreply@idleot.local>
Subject: [IdleOT] src/io/functions/iologindata_load_player.cpp

diff --git a/src/io/functions/iologindata_load_player.cpp b/src/io/functions/iologindata_load_player.cpp
index 1f0313c8..adff9e1b 100644
--- a/src/io/functions/iologindata_load_player.cpp
+++ b/src/io/functions/iologindata_load_player.cpp
@@ -161,7 +161,30 @@ bool IOLoginDataLoad::loadPlayerBasicInfo(const std::shared_ptr<Player> &player,
 		return false;
 	}
 
-	player->setBankBalance(result->getNumber<uint64_t>("balance"));
+	// Bank gold is account-scoped (per world/DB). Prefer an online alt's
+	// in-memory balance so unsaved deposits are not overwritten on login.
+	uint64_t accountBankBalance = 0;
+	bool foundOnlineAccountBank = false;
+	const auto accountId = player->getAccountId();
+	if (accountId != 0) {
+		for (const auto &[_, other] : g_game().getPlayers()) {
+			if (!other || other.get() == player.get() || other->getAccountId() != accountId) {
+				continue;
+			}
+			accountBankBalance = other->getBankBalance();
+			foundOnlineAccountBank = true;
+			break;
+		}
+		if (!foundOnlineAccountBank) {
+			const auto bankResult = Database::getInstance().storeQuery(
+				fmt::format("SELECT `balance` FROM `accounts` WHERE `id` = {}", accountId)
+			);
+			if (bankResult) {
+				accountBankBalance = bankResult->getNumber<uint64_t>("balance");
+			}
+		}
+	}
+	player->bankBalance = accountBankBalance;
 	player->quickLootFallbackToMainContainer = result->getNumber<bool>("quickloot_fallback");
 	player->setSex(static_cast<PlayerSex_t>(result->getNumber<uint16_t>("sex")));
 	player->setPronoun(static_cast<PlayerPronoun_t>(result->getNumber<uint16_t>("pronoun")));
@@ -563,7 +586,10 @@ void IOLoginDataLoad::loadPlayerInstantSpellList(const std::shared_ptr<Player> &
 	query << "SELECT `player_id`, `name` FROM `player_spells` WHERE `player_id` = " << player->getGUID();
 	if ((result = db.storeQuery(query.str()))) {
 		do {
-			player->learnedInstantSpellList.emplace(result->getString("name"));
+			// Match learnInstantSpell / hasLearnedInstantSpell (always lowercase).
+			// Mixed-case DB rows otherwise miss the set lookup and get re-learned,
+			// then save INSERT hits PRIMARY KEY (player_id, name) under CI collation.
+			player->learnedInstantSpellList.emplace(asLowerCaseString(result->getString("name")));
 		} while (result->next());
 	}
 }
