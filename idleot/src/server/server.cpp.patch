+bool ServiceManager::addWebSocketGame(uint16_t port) {
+	if (port == 0) {
+		return true;
+	}
+
+	websocketGamePort = std::make_shared<WebSocketServicePort>(io_service);
+	websocketGamePort->open(port);
+	return true;
