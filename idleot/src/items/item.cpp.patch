+bool Item::isVisibleInInstance(uint32_t viewerInstanceId) const {
+	if (instanceId != 0) {
+		return instanceId == viewerInstanceId;
+	}
+	if (viewerInstanceId != 0 && isStatefulMapTemplate()) {
+		const auto &parent = getParent();
+		const auto &tile = parent ? parent->getTile() : nullptr;
+		if (tile && tile->findStatefulMapFork(*this, viewerInstanceId)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+// Map-template items stay on instanceId 0 (shared hunt geometry). Includes items.xml
+// transform-on-use entries (transformToOnUse / transformOnUse) such as levers and lamps.
+bool Item::isMapTemplateItem() const {
+	if (instanceId != 0) {
+		return false;
+	}
+
+	if (isMagicField()) {
+		return loadedFromMap;
+	}
+
+	if (loadedFromMap) {
+		return true;
+	}
+
+	const ItemType &it = items[id];
+	if (it.isGroundTile() || it.floorChange != 0) {
+		return true;
+	}
+	if (it.isDoor() || it.isBed() || it.isTeleport() || it.isMailbox() || it.isTrashHolder()) {
+		return true;
+	}
+	if (it.transformToOnUse[0] != 0 || it.transformToOnUse[1] != 0 || it.m_transformOnUse != 0) {
+		return true;
+	}
+	// Immovable use-on-map fixtures (levers, lamps, switches) — not combat fields.
+	if (it.multiUse && !it.movable && !it.pickupable && !it.isMagicField()) {
+		return true;
+	}
+	if (hasAttribute(ItemAttribute_t::UNIQUEID) && !it.movable && !it.pickupable) {
+		return true;
+	}
+
+	return false;
+}
+
+bool Item::isStatefulMapTemplate() const {
+	if (!isMapTemplateItem() || isMagicField()) {
+		return false;
+	}
+
+	const ItemType &it = items[id];
+	if (it.isGroundTile()) {
+		return false;
+	}
+
+	if (loadedFromMap && !it.movable && !it.pickupable) {
+		return true;
+	}
+
+	return it.isDoor() || it.transformToOnUse[0] != 0 || it.transformToOnUse[1] != 0 || it.m_transformOnUse != 0
+		|| (it.multiUse && !it.movable && !it.pickupable);
+}
