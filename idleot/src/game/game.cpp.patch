+void Game::syncCreatureInstance(const std::shared_ptr<Creature> &creature) {
+	if (!creature || creature->getInstanceId() != 0) {
+		return;
+	}
+	callInstanceWorld("syncCreatureInstance", creature, creature->getPosition(), false);
+}
