+std::shared_ptr<PrivateChatChannel> Chat::createTeamChannel(const std::shared_ptr<Player> &player) {
+	if (!player) {
+		return nullptr;
+	}
+
+	if (const auto &existing = getPrivateChannel(player)) {
+		existing->closeChannel();
+		privateChannels.erase(existing->getId());
+	}
+
+	for (uint16_t i = 100; i < 10000; ++i) {
+		auto [iter, inserted] = privateChannels.try_emplace(
+			i, std::make_shared<PrivateChatChannel>(i, player->getName() + "'s Team Channel")
+		);
+		if (inserted) {
+			const auto &channel = iter->second;
+			channel->setOwner(player->getGUID());
+			return channel;
+		}
+	}
+	return nullptr;
+}
+
+bool Chat::closeTeamChannel(const std::shared_ptr<Player> &player, const std::string &closeMessage) {
+	if (!player) {
+		return false;
+	}
+
+	const auto &channel = getPrivateChannel(player);
+	if (!channel) {
+		return false;
+	}
+
+	if (!closeMessage.empty()) {
+		channel->sendToAll(closeMessage, TALKTYPE_CHANNEL_R1);
+	}
+
+	const uint16_t channelId = channel->getId();
+	channel->closeChannel();
+	privateChannels.erase(channelId);
+	return true;
+}
