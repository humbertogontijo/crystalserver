{
  "uid": "crystal-perf",
  "title": "CrystalServer performance",
  "tags": ["crystalserver"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Game state",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Players online",
      "description": "Headless = idle players kept online without a game client.",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 30 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (client) (game_players)", "legendFormat": "{{client}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active expeditions",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 30 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (role) (game_expeditions)", "legendFormat": "{{role}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Creatures",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(game_monsters)", "legendFormat": "monsters" },
        { "refId": "B", "expr": "sum(game_npcs)", "legendFormat": "npcs" }
      ]
    },
    {
      "type": "row",
      "title": "Dispatcher (game thread) - every player's ping waits on this",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Game thread busy (ms per second, 1000 = saturated)",
      "description": "Sum of all dispatcher task time per second. Spikes toward 1000 mean the single game thread had no idle time and every client's packets queued.",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 500 }, { "color": "red", "value": 900 } ] },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(task_latency_microseconds_sum[$__rate_interval])) / 1000", "legendFormat": "busy" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dispatcher tasks slower than 50 ms (count per minute)",
      "description": "Any task in this panel froze the game thread for at least 50 ms.",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "(sum by (task) (increase(task_latency_microseconds_count[1m])) - sum by (task) (increase(task_latency_microseconds_bucket{le=\"50000\"}[1m]))) > 0", "legendFormat": "{{task}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slowest dispatcher tasks (p99)",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(10, histogram_quantile(0.99, sum by (le, task) (rate(task_latency_microseconds_bucket[$__rate_interval])))) / 1000", "legendFormat": "{{task}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dispatcher time by task (ms per second)",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 30 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(10, sum by (task) (rate(task_latency_microseconds_sum[$__rate_interval]))) / 1000", "legendFormat": "{{task}}" }
      ]
    },
    {
      "type": "table",
      "title": "Total dispatcher time in the selected range (by task)",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "sortBy": [ { "displayName": "Total ms", "desc": true } ] },
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value #A": "Total ms", "Value #B": "Calls", "Value #C": "Calls over 50 ms" } } }
      ],
      "targets": [
        { "refId": "A", "expr": "topk(25, sum by (task) (increase(task_latency_microseconds_sum[$__range]))) / 1000", "instant": true, "format": "table" },
        { "refId": "B", "expr": "sum by (task) (increase(task_latency_microseconds_count[$__range]))", "instant": true, "format": "table" },
        { "refId": "C", "expr": "sum by (task) (increase(task_latency_microseconds_count[$__range])) - sum by (task) (increase(task_latency_microseconds_bucket{le=\"50000\"}[$__range]))", "instant": true, "format": "table" }
      ]
    },
    {
      "type": "row",
      "title": "Lua (scope = script file : direct call or timer)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Lua time by script (ms per second)",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 30 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(10, sum by (scope) (rate(lua_latency_microseconds_sum[$__rate_interval]))) / 1000", "legendFormat": "{{scope}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Lua calls slower than 50 ms (count per minute)",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "(sum by (scope) (increase(lua_latency_microseconds_count[1m])) - sum by (scope) (increase(lua_latency_microseconds_bucket{le=\"50000\"}[1m]))) > 0", "legendFormat": "{{scope}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slowest Lua scripts (p99)",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 46 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(10, histogram_quantile(0.99, sum by (le, scope) (rate(lua_latency_microseconds_bucket[$__rate_interval])))) / 1000", "legendFormat": "{{scope}}" }
      ]
    },
    {
      "type": "row",
      "title": "Database, C++ methods, locks",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 55 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "SQL time by query (ms per second)",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(10, sum by (truncated_query) (rate(query_latency_microseconds_sum[$__rate_interval]))) / 1000", "legendFormat": "{{truncated_query}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slowest SQL queries (p99)",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(10, histogram_quantile(0.99, sum by (le, truncated_query) (rate(query_latency_microseconds_bucket[$__rate_interval])))) / 1000", "legendFormat": "{{truncated_query}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Slowest instrumented C++ methods (p99)",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 65 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(10, histogram_quantile(0.99, sum by (le, method) (rate(method_latency_microseconds_bucket[$__rate_interval])))) / 1000", "legendFormat": "{{method}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Lock wait (p99)",
      "datasource": { "type": "prometheus", "uid": "crystal-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 65 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(10, histogram_quantile(0.99, sum by (le, scope) (rate(lock_latency_microseconds_bucket[$__rate_interval])))) / 1000", "legendFormat": "{{scope}}" }
      ]
    }
  ]
}
